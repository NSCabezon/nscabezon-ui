{
  "name": "@nscabezon/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Componentes y hooks React compartidos entre Gesmoto y TusExámenes: ResponsiveList, preferencias de listado, paginación y aviso de versión nueva.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./list": {
      "types": "./dist/list.d.ts",
      "import": "./dist/list.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:dist",
    "check:dist": "node -e \"const o=require('node:child_process').execSync('git status --porcelain -- dist').toString();if(o){console.error('dist/ no está al día con src/: commitea el dist regenerado.\\n'+o);process.exit(1)}\""
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "lucide-react": ">=1",
    "radix-ui": "^1.5",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  }
}
